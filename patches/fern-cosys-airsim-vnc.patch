+                "NVIDIA RTX 4000 Ada Generation".into(),
+            ]
+        });
+
+    DeploymentSpec {
+        name: "fern-cosys-airsim-vnc".into(),
+        image: image.unwrap_or_else(|| COSYS_AIRSIM_VNC_IMAGE.into()),
